# Public Google Identity Services web client ID.
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Generate two different random secrets with at least 32 characters each.
SESSION_SECRET=replace-with-a-random-session-secret
API_KEY_ENCRYPTION_SECRET=replace-with-a-random-api-key-encryption-secret

# Comma-separated Google account emails allowed to open /admin.
ADMIN_EMAILS=owner@example.com

# Railway/local production persistence. Mount a volume here in production.
MERCATO_DATA_DIR=.mercato-data

# Dola-compatible upstream.
DOLA_BASE_URL=https://api.dolaio.cn/aigateway/cisco/v1
AGENT_MODEL=MiniMax-M3
IMAGE_MODEL=gpt-image-2
VIDEO_MODEL=novai/seedance-2.0-mini
IMAGE_MODEL_IMAGE_2=gpt-image-2
IMAGE_MODEL_NANO_2_LITE=nano-banana-2-lite
IMAGE_MODEL_NANO_2=nano-banana-2
VIDEO_MODEL_SEEDANCE_FAST=novai/seedance-2.0-fast
VIDEO_MODEL_SEEDANCE_MINI=novai/seedance-2.0-mini
# Dola 当前将完整 Seedance 2.0 作为高质量档，对外展示名为 Seedance 2.0 pro。
VIDEO_MODEL_SEEDANCE_PRO=novai/seedance-2.0
VIDEO_ANALYSIS_MODEL=yunwu/claude-opus-4-8
VIDEO_ANALYSIS_FALLBACK_MODEL=dolaio/gpt-5.6-terra
IMAGE_DEFAULT_QUALITY=medium
IMAGE_DEFAULT_SQUARE_SIZE=1024x1024
IMAGE_RETRY_DELAYS_MS=10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000,10000
VIDEO_DEFAULT_RESOLUTION=720p
VIDEO_DEFAULT_DURATION_SECONDS=15
VIDEO_DEFAULT_WATERMARK=false

# Persistent image task service.
TASK_BACKEND_URL=https://your-task-backend.example.com
TASK_BACKEND_TOKEN=replace-with-the-shared-internal-token
